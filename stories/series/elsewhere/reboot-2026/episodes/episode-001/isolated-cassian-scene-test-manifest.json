      "voice_id": "f91cc0b0eea44f8391f080d2de079ea2",
      "gain": 1,
      "text": "With your face?",
      "audio_url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/f91cc0b0eea44f8391f080d2de079ea2/id=7785353ae42845bdb3a495eafbc6f20c.wav",
