      "speaker": "narrator",
      "voice_id": "a3a4aa242aaf431ea8ec2c4b3bb332fa",
      "gain": 1,
      "source_text": "She went quiet long enough to make him worry he'd frightened her.",
      "scene": "The Money He Didn't Explain",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/a3a4aa242aaf431ea8ec2c4b3bb332fa/id=e7ae0375cd2c457793e529b13044281a.wav",
