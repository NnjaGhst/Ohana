      "speaker": "ninja",
      "voice_id": "8f71d16d1fa84544a4db41a18264d613",
      "gain": 0.9,
      "source_text": "What's funny?",
      "scene": "The Money He Didn't Explain",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/8f71d16d1fa84544a4db41a18264d613/id=3972eb03e3f54b7883162b88c9581f56.wav",
      "duration": 1.1059410430839003
    },
