      "speaker": "cassian",
      "voice_id": "f91cc0b0eea44f8391f080d2de079ea2",
      "gain": 1,
      "source_text": "Nothing. You. The fact that shelving has become a combat sport.",
      "scene": "The Money He Didn't Explain",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/f91cc0b0eea44f8391f080d2de079ea2/id=9e0a29c05a96456992bb6e3254a55e59.wav",
      "duration": 4.578503401360544
