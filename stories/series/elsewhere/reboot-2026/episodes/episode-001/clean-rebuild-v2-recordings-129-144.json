      "voice_id": "f91cc0b0eea44f8391f080d2de079ea2",
      "gain": 1,
      "source_text": "No. Just wanted to hear your voice.",
      "scene": "The Money He Didn't Explain",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/f91cc0b0eea44f8391f080d2de079ea2/id=205b457dc2b742bf8290ccac46eca2ed.wav",
