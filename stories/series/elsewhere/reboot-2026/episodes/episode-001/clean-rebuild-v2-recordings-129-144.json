      "source_text": "Come over Sunday. I'll cook.",
      "scene": "The Money He Didn't Explain",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/8f71d16d1fa84544a4db41a18264d613/id=ed2f609d43bf41a4850a45067bcdeb76.wav",
