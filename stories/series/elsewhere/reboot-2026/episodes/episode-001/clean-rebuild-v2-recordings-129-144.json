      "voice_id": "8f71d16d1fa84544a4db41a18264d613",
      "gain": 0.9,
      "source_text": "Well, you've heard it. It remains incredibly charming.",
      "scene": "The Money He Didn't Explain",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/8f71d16d1fa84544a4db41a18264d613/id=7defd52f82044097b53e92b136b435de.wav",
