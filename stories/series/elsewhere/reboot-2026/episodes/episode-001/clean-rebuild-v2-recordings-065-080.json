      "speaker": "ninja",
      "voice_id": "8f71d16d1fa84544a4db41a18264d613",
      "gain": 0.9,
      "source_text": "Wonderful. Saves me explaining.",
      "scene": "The Person Who Stayed",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/8f71d16d1fa84544a4db41a18264d613/id=0923176d14524f44b7472846e9458f86.wav",
      "duration": 2.6441269841269843
    },
    {
      "cue_id": "line-071",
      "run_id": 67,
      "speaker": "cassian",
      "voice_id": "f91cc0b0eea44f8391f080d2de079ea2",
      "gain": 1,
      "source_text": "The van at work broke down.",
      "scene": "The Person Who Stayed",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/f91cc0b0eea44f8391f080d2de079ea2/id=ddbbcf140b0645d6b241a06625bdc16d.wav",
      "duration": 1.86578231292517
    },
    {
      "cue_id": "line-072",
      "run_id": 68,
      "speaker": "ninja",
      "voice_id": "8f71d16d1fa84544a4db41a18264d613",
      "gain": 0.9,
      "source_text": "Did the van also break your phone?",
      "scene": "The Person Who Stayed",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/8f71d16d1fa84544a4db41a18264d613/id=4638f76ae96e4371b8b8a173a87343b0.wav",
      "duration": 2.0984580498866214
    },
    {
      "cue_id": "line-073",
      "run_id": 69,
      "speaker": "cassian",
      "voice_id": "f91cc0b0eea44f8391f080d2de079ea2",
      "gain": 1,
      "source_text": "No. That was me being an idiot.",
      "scene": "The Person Who Stayed",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/f91cc0b0eea44f8391f080d2de079ea2/id=5cfa53f5524b4fe6a8a0e6179a6bfd0b.wav",
      "duration": 2.6441269841269843
    },
    {
      "cue_id": "line-074",
      "run_id": 70,
      "speaker": "ninja",
      "voice_id": "8f71d16d1fa84544a4db41a18264d613",
      "gain": 0.9,
      "source_text": "Finally, a diagnosis.",
      "scene": "The Person Who Stayed",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/8f71d16d1fa84544a4db41a18264d613/id=244efc1277284be6840c08dae1b237e6.wav",
