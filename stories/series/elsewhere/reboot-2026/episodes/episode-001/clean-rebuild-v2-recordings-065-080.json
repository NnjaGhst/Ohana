    },
    {
      "cue_id": "line-075",
      "run_id": 71,
      "speaker": "narrator",
      "voice_id": "a3a4aa242aaf431ea8ec2c4b3bb332fa",
      "gain": 1,
      "source_text": "He put the bags on the table.",
      "scene": "The Person Who Stayed",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/a3a4aa242aaf431ea8ec2c4b3bb332fa/id=64434aa54ba148289bae3d13fcd6617b.wav",
      "duration": 1.6907482993197278
    },
    {
      "cue_id": "line-076",
      "run_id": 72,
      "speaker": "cassian",
      "voice_id": "f91cc0b0eea44f8391f080d2de079ea2",
      "gain": 1,
      "source_text": "I was wrong. I'm sorry.",
      "scene": "The Person Who Stayed",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/f91cc0b0eea44f8391f080d2de079ea2/id=d2a722246d1c4b6fb129716c5e2fff42.wav",
      "duration": 1.7507256235827664
    },
    {
      "cue_id": "line-077",
      "run_id": 73,
      "speaker": "narrator",
      "voice_id": "a3a4aa242aaf431ea8ec2c4b3bb332fa",
      "gain": 1,
      "source_text": "Ninja held on to her anger for another few seconds, mostly out of principle. Then she opened the bag.",
      "scene": "The Person Who Stayed",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/a3a4aa242aaf431ea8ec2c4b3bb332fa/id=7fafd34f000b4dd392fd8ceb17a33755.wav",
      "duration": 5.9833106575963715
    },
    {
      "cue_id": "line-078",
      "run_id": 74,
      "speaker": "ninja",
      "voice_id": "8f71d16d1fa84544a4db41a18264d613",
      "gain": 0.9,
      "source_text": "Did you get extra chips?",
      "scene": "The Person Who Stayed",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/8f71d16d1fa84544a4db41a18264d613/id=9281e1b607af4884b2e626e74b9fa1e0.wav",
      "duration": 1.561700680272109
    },
    {
      "cue_id": "line-079",
      "run_id": 75,
      "speaker": "cassian",
      "voice_id": "f91cc0b0eea44f8391f080d2de079ea2",
      "gain": 1,
      "source_text": "Do I look suicidal?",
      "scene": "The Person Who Stayed",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/f91cc0b0eea44f8391f080d2de079ea2/id=5262f2a1e5ac44c3a1cb352376a7d1e7.wav",
      "duration": 1.43421768707483
    },
    {
      "cue_id": "line-080",
      "run_id": 76,
      "speaker": "narrator",
      "voice_id": "a3a4aa242aaf431ea8ec2c4b3bb332fa",
      "gain": 1,
      "source_text": "She tried not to smile. He saw it anyway. As they grew older, Ninja started taking care of him, too: saving him dinner, warning him when people took advantage, and occasionally dragging him out of trouble. One evening he came home exhausted and collapsed on the sofa. She put on a dreadful action film they'd seen a dozen times. Halfway through, he opened one eye.",
      "scene": "The Person Who Stayed",
