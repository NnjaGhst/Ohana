      "speaker": "narrator",
      "voice_id": "a3a4aa242aaf431ea8ec2c4b3bb332fa",
      "gain": 1,
      "source_text": "When he was done, he crouched in front of her and held out his hands.",
      "scene": "Before There Were Secrets",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/a3a4aa242aaf431ea8ec2c4b3bb332fa/id=24c45f23da8f40b7bf0d0e8613c00bf6.wav",
