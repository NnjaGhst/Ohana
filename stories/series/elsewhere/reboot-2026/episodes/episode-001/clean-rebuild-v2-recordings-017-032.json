      "speaker": "cassian",
      "voice_id": "f91cc0b0eea44f8391f080d2de079ea2",
      "gain": 1,
      "source_text": "Yes. That's the treatment. All doctors do it.",
      "scene": "Before There Were Secrets",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/f91cc0b0eea44f8391f080d2de079ea2/id=3aed02a0189f4dd3ae076d36b260d9ce.wav",
