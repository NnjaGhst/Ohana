      "voice_id": "8f71d16d1fa84544a4db41a18264d613",
      "gain": 0.9,
      "source_text": "You're pulling my leg off.",
      "scene": "Before There Were Secrets",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/8f71d16d1fa84544a4db41a18264d613/id=fba165c59c154d34bc413fb60815078d.wav",
