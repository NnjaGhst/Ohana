      "gain": 1,
      "source_text": "Then you should've been. Fear can be useful.",
      "scene": "Before There Were Secrets",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/f91cc0b0eea44f8391f080d2de079ea2/id=e5743d3daf06425680602d54e50683c9.wav",
