      "speaker": "narrator",
      "voice_id": "a3a4aa242aaf431ea8ec2c4b3bb332fa",
      "gain": 1,
      "source_text": "She hated that answer. Cassian tilted his head.",
      "scene": "Before There Were Secrets",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/a3a4aa242aaf431ea8ec2c4b3bb332fa/id=6a14adb785a64df8b86dccde7b3ace8b.wav",
      "duration": 3.7521541950113377
    },
    {
      "cue_id": "line-035",
      "run_id": 33,
      "speaker": "cassian",
      "voice_id": "f91cc0b0eea44f8391f080d2de079ea2",
      "gain": 1,
      "source_text": "Look at me. Nin. Being brave isn't the same as being stupid.",
      "scene": "Before There Were Secrets",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/f91cc0b0eea44f8391f080d2de079ea2/id=a070510066574c8ca7687c43418dbd82.wav",
      "duration": 4.397233560090703
    },
    {
      "cue_id": "line-036",
      "run_id": 34,
      "speaker": "ninja",
      "voice_id": "8f71d16d1fa84544a4db41a18264d613",
      "gain": 0.9,
      "source_text": "You're stupid.",
      "scene": "Before There Were Secrets",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/8f71d16d1fa84544a4db41a18264d613/id=46c2aa146e2d421ebcee429d879663ed.wav",
