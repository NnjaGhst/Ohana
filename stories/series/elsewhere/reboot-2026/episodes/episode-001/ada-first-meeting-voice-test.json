  "cues": [
    {
      "id": "scene-ada-01",
      "character": "narrator",
      "text": "She found the building above the bakery on her second attempt. The owner, a woman called Ada, opened the door before Ninja had managed to ring the bell.",
      "source_paragraphs": [
        10
      ],
      "gain": 1,
      "voice_id": "a3a4aa242aaf431ea8ec2c4b3bb332fa",
      "audio_url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/a3a4aa242aaf431ea8ec2c4b3bb332fa/id=acab0b6c45fa4a7da3267f71ee433603.wav",
      "duration_seconds": 8.289931972789116
    },
    {
      "id": "scene-ada-02",
      "character": "ada",
      "text": "You must be the new guest.",
      "source_paragraphs": [
        11
      ],
      "gain": 1,
      "voice_id": "776f9d2ff401499a8f1f2bcb4ca46004",
      "audio_url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/776f9d2ff401499a8f1f2bcb4ca46004/id=2a2241eb310141d2907856f628e3e387.wav",
      "duration_seconds": 1.9695691609977324
    },
    {
      "id": "scene-ada-03",
      "character": "ninja",
      "text": "That depends. Does the room have a bed?",
      "source_paragraphs": [
        12
      ],
      "gain": 0.9,
      "voice_id": "8f71d16d1fa84544a4db41a18264d613",
      "audio_url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/8f71d16d1fa84544a4db41a18264d613/id=345db8bf2e3a4366856fe52f2d53713a.wav",
      "duration_seconds": 2.7718367346938777
    },
    {
      "id": "scene-ada-04",
      "character": "ada",
      "text": "Usually.",
      "source_paragraphs": [
        13
      ],
      "gain": 1,
      "voice_id": "776f9d2ff401499a8f1f2bcb4ca46004",
      "audio_url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/776f9d2ff401499a8f1f2bcb4ca46004/id=b02c9acb708742559f775feb544a5e5f.wav",
      "duration_seconds": 1.0504081632653062
    },
    {
      "id": "scene-ada-05",
      "character": "ninja",
      "text": "Then yes. Definitely me.",
      "source_paragraphs": [
        14
      ],
      "gain": 0.9,
      "voice_id": "8f71d16d1fa84544a4db41a18264d613",
      "audio_url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/8f71d16d1fa84544a4db41a18264d613/id=3a78005063624b01a1e60d66ed66261c.wav",
      "duration_seconds": 2.6167120181405896
    },
    {
      "id": "scene-ada-06",
      "character": "narrator",
      "text": "Ada gave her an assessing look, but it wasn't the look Ninja had grown accustomed to. No careful lowering of the eyes. No flicker of recognition at a surname. No searching her face for evidence of whether today was a good day to mention her brother. Just a woman in a cardigan holding a door.",
      "source_paragraphs": [
        15,
        16
      ],
      "gain": 1,
      "voice_id": "a3a4aa242aaf431ea8ec2c4b3bb332fa",
      "audio_url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/a3a4aa242aaf431ea8ec2c4b3bb332fa/id=550613373b374f0eb678b48393aba99d.wav",
      "duration_seconds": 16.662471655328797
    },
    {
      "id": "scene-ada-07",
      "character": "ada",
      "text": "Upstairs, then. You'll find the kettle by the window. Mind the third step. It makes a noise like a dying goose.",
      "source_paragraphs": [
        17
      ],
      "gain": 1,
      "voice_id": "776f9d2ff401499a8f1f2bcb4ca46004",
      "audio_url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/776f9d2ff401499a8f1f2bcb4ca46004/id=5407b8673dc84905b51c664a78992141.wav",
      "duration_seconds": 7.589977324263039
    },
    {
      "id": "scene-ada-08",
      "character": "ninja",
      "text": "I've lived with worse.",
      "source_paragraphs": [
        18
      ],
      "gain": 0.9,
      "voice_id": "8f71d16d1fa84544a4db41a18264d613",
      "audio_url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/8f71d16d1fa84544a4db41a18264d613/id=63dd71c3be27475a97df913ec875f057.wav",
      "duration_seconds": 1.633718820861678
    },
    {
      "id": "scene-ada-09",
      "character": "ada",
      "text": "Oh, haven't we all.",
      "source_paragraphs": [
        19
      ],
      "gain": 1,
      "voice_id": "776f9d2ff401499a8f1f2bcb4ca46004",
      "audio_url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/776f9d2ff401499a8f1f2bcb4ca46004/id=f7cc9455c0c64b498528ab1a936505ba.wav",
      "duration_seconds": 1.6689795918367347
    }
