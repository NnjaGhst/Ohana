      "speaker": "handler",
      "voice_id": "e8ad4ba6c5e241549c1920fda63eb878",
      "gain": 1,
      "source_text": "It's an opportunity to continue being reliable.",
      "scene": "The Money He Didn't Explain",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/e8ad4ba6c5e241549c1920fda63eb878/id=f2ca4dc36b504604ad918dd01b42ae0f.wav",
