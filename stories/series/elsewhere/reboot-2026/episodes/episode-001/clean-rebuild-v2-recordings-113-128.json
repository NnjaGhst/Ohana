      "speaker": "courier",
      "voice_id": "eae6fca42aae4b78b992533e96ab43c9",
      "gain": 1,
      "source_text": "Paperwork.",
      "scene": "The Money He Didn't Explain",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/eae6fca42aae4b78b992533e96ab43c9/id=fb542c618fc94b73a5fbcae42e010333.wav",
      "duration": 1.246530612244898
    },
    {
      "cue_id": "line-119",
