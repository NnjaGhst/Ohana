      "speaker": "cassian",
      "voice_id": "f91cc0b0eea44f8391f080d2de079ea2",
      "gain": 1,
      "source_text": "Is that supposed to be a compliment?",
      "scene": "The Money He Didn't Explain",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/f91cc0b0eea44f8391f080d2de079ea2/id=b1b5d88603bb4f50a94186cee40a9aea.wav",
