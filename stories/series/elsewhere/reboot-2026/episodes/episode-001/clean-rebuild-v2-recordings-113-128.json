      "speaker": "narrator",
      "voice_id": "a3a4aa242aaf431ea8ec2c4b3bb332fa",
      "gain": 1,
      "source_text": "He took a breath. For a second she thought he would. Instead, he picked up the envelope.",
      "scene": "The Money He Didn't Explain",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/a3a4aa242aaf431ea8ec2c4b3bb332fa/id=34bca38b666d4e05aee35e892dbdc933.wav",
