    },
    {
      "cue_id": "line-115",
      "run_id": 108,
      "speaker": "cassian",
      "voice_id": "f91cc0b0eea44f8391f080d2de079ea2",
      "gain": 1,
      "source_text": "Trying to make something easier for once.",
      "scene": "The Money He Didn't Explain",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/f91cc0b0eea44f8391f080d2de079ea2/id=84c8d65832b940e7a6de2d23f7d0fb79.wav",
      "duration": 2.5164172335600905
    },
    {
      "cue_id": "line-116",
      "run_id": 109,
      "speaker": "narrator",
      "voice_id": "a3a4aa242aaf431ea8ec2c4b3bb332fa",
      "gain": 1,
      "source_text": "She let him leave without another argument. She told herself he was an adult. That he had a right to parts of his life that weren't hers. That she could love him without interrogating him. And all of that was true. It wasn't the whole truth. The first job had sounded almost insulting in its simplicity. A man who knew a man asked Cassian to take a sealed parcel across town. Cash on delivery. No questions. He asked one anyway.",
      "scene": "The Money He Didn't Explain",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/a3a4aa242aaf431ea8ec2c4b3bb332fa/id=d6b9366310c3494395be3b29638e1a95.wav",
      "duration": 23.849047619047617
    },
    {
      "cue_id": "line-117",
      "run_id": 110,
      "speaker": "cassian",
      "voice_id": "f91cc0b0eea44f8391f080d2de079ea2",
      "gain": 1,
      "source_text": "What's inside?",
      "scene": "The Money He Didn't Explain",
      "url": "https://resource2.heygen.ai/text_to_speech/614a49c8312e4000b7232bd515dc476e/f91cc0b0eea44f8391f080d2de079ea2/id=5acdcc57c2324146832d1082278ffb09.wav",
      "duration": 1.0592970521541951
